{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "delete build",
      "type": "shell",
      "command": "rm",
      "args": [
        "-rf",
        "${workspaceFolder}/build/"
      ]
    },
    {
      "label": "generate build dxc",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-B", "${workspaceFolder}/build/",
        "-C", "cmake/caches/PredefinedParams.cmake",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-G", "Ninja"
      ]
    },
    {
      "label": "build dxc",
      "type": "shell",
      "command": "ninja",
      "args": [
        "-C", "${workspaceFolder}/build"
      ]
    },
    {
      "label": "CMake: BUILD (Debug)",
      "dependsOn": ["generate build dxc", "build dxc"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run dxc",
      "type": "shell",
      "command": "${workspaceFolder}/build/bin/dxc",
      "args": [
        "${input:shaderFile}",
        "-spirv",
        "-fspv-target-env=vulkan1.3",
        "-enable-16bit-types",
        "-T",
        "cs_6_5",
        "-fcgl"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "shaderFile",
      "type": "promptString",
      "description": "Enter the path to the shader file",
      "default": ""
    }
  ]
}